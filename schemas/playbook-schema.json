          "$ref": "#/$defs/PdfSpec"
        },
        "pe": {
          "$ref": "#/$defs/PeSpec"
        },
        "ref": {
          "description": "Instead of path: the one live path created under this id.",
          "type": "string"
        },
        "referrer_url": {
          "type": "string"
        },
        "refs": {
          "description": "Instead of path: every live path created under this id.",
          "type": "string"
