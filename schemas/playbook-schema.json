      "type": "object"
    },
    "HistorySpec": {
      "additionalProperties": false,
      "properties": {
        "downloads": {
          "items": {
            "$ref": "#/$defs/HistoryDownload"
          },
          "type": "array"
        },
        "visits": {
          "items": {
            "$ref": "#/$defs/HistoryVisit"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "HistoryVisit": {
      "additionalProperties": false,
      "properties": {
        "from_visit": {
          "minimum": 0,
          "type": "integer"
        },
        "time": {
          "$ref": "#/$defs/Rfc3339Time"
        },
        "title": {
          "type": "string"
        },
        "transition": {
          "enum": [
            "link",
            "typed",
            "bookmark",
            "generated",
            "form_submit",
            "reload"
          ],
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "OperationAction": {
      "enum": [
        "create",
        "update",
        "append",
        "edit",
        "delete",
        "mace",
        "rename",
        "copy",
        "truncate",
        "rotate",
        "archive",
        "email",
        "ansible-vault",
        "ads",
        "motw"
      ],
      "type": "string"
    },
    "PdfSpec": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "created": {
          "$ref": "#/$defs/Rfc3339Time"
        },
        "creator": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "modified": {
          "$ref": "#/$defs/Rfc3339Time"
        },
        "page_size": {
          "enum": [
            "A4",
            "A3",
            "A5",
            "Letter"
          ],
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "PeSection": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "items": {
            "enum": [
              "code",
              "initialized_data",
              "uninitialized_data",
              "execute",
              "read",
              "write",
              "discardable"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "maxLength": 8,
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "PeSpec": {
      "additionalProperties": false,
      "properties": {
        "dll": {
          "type": "boolean"
        },
        "imports": {
          "description": "Imported functions as dll!function, for example kernel32.dll!CreateFileW.",
          "items": {
            "pattern": "^[^!]+![^!]+$",
            "type": "string"
          },
          "type": "array"
        },
        "machine": {
          "enum": [
            "amd64",
            "i386",
            "arm64"
          ],
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/PeSection"
          },
          "type": "array"
        },
        "subsystem": {
          "enum": [
            "console",
            "gui",
            "native"
          ],
          "type": "string"
        },
        "timestamp": {
          "description": "RFC 3339, or \"0\" for the zero stamp a reproducible build writes. Defaults to the operation time.",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/PeVersion"
        }
      },
      "type": "object"
    },
    "PeVersion": {
      "additionalProperties": false,
      "properties": {
        "company_name": {
          "type": "string"
        },
        "file_description": {
          "type": "string"
        },
        "file_version": {
          "type": "string"
        },
        "internal_name": {
          "type": "string"
        },
        "legal_copyright": {
          "type": "string"
        },
        "original_filename": {
          "type": "string"
        },
        "product_name": {
          "type": "string"
        },
        "product_version": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Rfc3339Time": {
      "description": "Timestamp in RFC 3339 format, fractional seconds allowed",
      "format": "date-time",
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "repeat": {
                "minimum": 2
              }
            },
            "required": [
              "repeat"
            ]
          },
          "then": {
            "required": [
              "every"
            ]
          }
        }
      ],
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "minItems": 1,
          "type": "array"
        },
        "actor": {
          "type": "string"
        },
        "batch_count": {
          "minimum": 1,
          "type": "integer"
        },
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "every": {
          "$ref": "#/$defs/Duration"
        },
        "offset": {
          "$ref": "#/$defs/Duration"
        },
        "repeat": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "actor",
        "actions"
      ],
      "type": "object"
    },
    "Template": {
      "enum": [
        "email",
        "log",
        "script",
        "doc"
      ],
      "type": "string"
    },
    "VaultSpec": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "type": "string"
        },
        "salt": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "vault_id": {
          "type": "string"
        }
      },
      "required": [
        "password"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/aoiflux/fsagen/main/schemas/playbook-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Documents fsagen playbook input files. fsagen validates input itself; this schema mirrors those rules for editors.",
  "properties": {
    "actors": {
      "items": {
        "$ref": "#/$defs/Actor"
      },
      "minItems": 1,
      "type": "array"
    },
    "start": {
      "description": "RFC 3339 start of the scenario, or \"now\" for a run that cannot be reproduced.",
      "oneOf": [
        {
          "const": "now"
        },
        {
          "$ref": "#/$defs/Rfc3339Time"
        }
      ]
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "type": "array"
    },
    "subsecond_jitter": {
      "description": "Add a seeded fraction of a second to every time derived from the schedule, never to an explicit one.",
      "type": "boolean"
    },
    "variables": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "start",
    "actors",
    "steps"
  ],
  "title": "FSAGen Playbook Schema",
  "type": "object"
}
