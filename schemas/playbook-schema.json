          "type": "string"
        },
        "missing_ok": {
          "description": "delete: a missing path is a recorded no-op.",
          "type": "boolean"
        },
        "mode": {
          "description": "Octal file permissions, for example 0600",
          "pattern": "^0?[0-7]{3,4}$",
          "type": "string"
        },
        "mtime": {
          "$ref": "#/$defs/Rfc3339Time"
