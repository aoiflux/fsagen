{
  "$defs": {
    "Attachment": {
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "source_file"
          ]
        },
        {
          "required": [
            "source_root"
          ]
        },
        {
          "required": [
            "content"
          ]
        }
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "content_id": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "disposition": {
          "enum": [
            "attachment",
            "inline"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "source_root": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "EmailSpec": {
      "additionalProperties": false,
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "type": "array"
        },
        "bcc": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "body_html": {
          "type": "string"
        },
        "body_html_file": {
          "type": "string"
        },
        "body_text": {
          "type": "string"
        },
        "body_text_file": {
          "type": "string"
        },
        "cc": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "date": {
          "$ref": "#/$defs/Rfc3339Time"
        },
        "from": {
          "type": "string"
        },
        "headers": {
          "items": {
            "$ref": "#/$defs/Header"
          },
          "type": "array"
        },
        "in_reply_to": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reply_to": {
          "type": "string"
        },
        "return_path": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "to": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "create"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "enum": [
                  "raw",
                  "text",
                  "pdf"
                ]
              }
            },
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "content",
                "content_file",
                "content_len",
                "ext",
                "format",
                "id",
                "mode",
                "mtime",
                "path",
                "pdf",
                "render",
                "type"
              ]
            },
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "update"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ],
            "properties": {
              "format": {
                "enum": [
                  "raw",
                  "text",
                  "pdf"
                ]
              }
            },
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "content",
                "content_file",
                "content_len",
                "format",
                "mode",
                "mtime",
                "path",
                "pdf",
                "ref",
                "render"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "append"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "content",
                "content_file",
                "content_len",
                "id",
                "mode",
                "mtime",
                "path",
                "ref",
                "render"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "missing_ok",
                "mtime",
                "path",
                "ref",
                "refs"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "mace"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "atime"
                ]
              },
              {
                "required": [
                  "mtime"
                ]
              }
            ],
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "mode",
                "mtime",
                "path",
                "ref",
                "refs"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "rename"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "id",
                "new_path",
                "path",
                "ref"
              ]
            },
            "required": [
              "new_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "copy"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "id",
                "mode",
                "mtime",
                "new_path",
                "path",
                "ref"
              ]
            },
            "required": [
              "new_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "truncate"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "mode",
                "mtime",
                "path",
                "ref",
                "refs"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "rotate"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "mode",
                "mtime",
                "new_path",
                "path",
                "ref"
              ]
            },
            "required": [
              "new_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "email"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "enum": [
                  "eml",
                  "mbox"
                ]
              }
            },
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "email",
                "format",
                "id",
                "mode",
                "mtime",
                "path"
              ]
            },
            "required": [
              "email",
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "ansible-vault"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "content",
                "content_file",
                "id",
                "mode",
                "mtime",
                "path",
                "render",
                "vault"
              ]
            },
            "required": [
              "vault",
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "ads"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "content",
                "content_file",
                "content_len",
                "mtime",
                "path",
                "ref",
                "refs",
                "render",
                "stream"
              ]
            },
            "required": [
              "stream"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "motw"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "refs"
                ]
              }
            ],
            "propertyNames": {
              "enum": [
                "action",
                "atime",
                "host_url",
                "mtime",
                "path",
                "ref",
                "referrer_url",
                "refs",
                "zone_id"
              ]
            }
          }
        },
        {
          "not": {
            "required": [
              "content",
              "content_file"
            ]
          }
        },
        {
          "not": {
            "required": [
              "content_len",
              "content"
            ]
          }
        }
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/OperationAction"
        },
        "atime": {
          "$ref": "#/$defs/Rfc3339Time"
        },
        "content": {
          "type": "string"
        },
        "content_file": {
          "type": "string"
        },
        "content_len": {
          "minimum": 1,
          "type": "integer"
        },
        "email": {
          "$ref": "#/$defs/EmailSpec"
        },
        "ext": {
          "pattern": "^\\.[^/\\\\:]+$",
          "type": "string"
        },
        "format": {
          "enum": [
            "raw",
            "text",
            "pdf",
            "eml",
            "mbox"
          ],
          "type": "string"
        },
        "host_url": {
          "type": "string"
        },
        "id": {
          "description": "Names what this action creates or renames, for later ref/refs.",
          "type": "string"
        },
        "missing_ok": {
          "description": "delete: a missing path is a recorded no-op.",
          "type": "boolean"
        },
        "mode": {
          "description": "Octal file permissions, for example 0600",
          "pattern": "^0?[0-7]{3,4}$",
          "type": "string"
        },
        "mtime": {
          "$ref": "#/$defs/Rfc3339Time"
        },
        "new_path": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pdf": {
          "$ref": "#/$defs/PdfSpec"
        },
        "ref": {
          "description": "Instead of path: the one live path created under this id.",
          "type": "string"
        },
        "referrer_url": {
          "type": "string"
        },
        "refs": {
          "description": "Instead of path: every live path created under this id.",
          "type": "string"
        },
        "render": {
          "type": "boolean"
        },
        "stream": {
          "type": "string"
        },
        "type": {
          "enum": [
            "file",
            "dir"
          ],
          "type": "string"
        },
        "vault": {
          "$ref": "#/$defs/VaultSpec"
        },
        "zone_id": {
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "OperationAction": {
      "enum": [
        "create",
        "update",
        "append",
        "delete",
        "mace",
        "rename",
        "copy",
        "truncate",
        "rotate",
        "email",
        "ansible-vault",
        "ads",
        "motw"
      ],
      "type": "string"
    },
    "PdfSpec": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "created": {
          "$ref": "#/$defs/Rfc3339Time"
        },
        "creator": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "modified": {
          "$ref": "#/$defs/Rfc3339Time"
        },
        "page_size": {
          "enum": [
            "A4",
            "A3",
            "A5",
            "Letter"
          ],
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Rfc3339Time": {
      "description": "Timestamp in RFC 3339 format, fractional seconds allowed",
      "format": "date-time",
      "type": "string"
    },
    "VaultSpec": {
      "additionalProperties": false,
      "properties": {
        "password": {
          "type": "string"
        },
        "salt": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "vault_id": {
          "type": "string"
        }
      },
      "required": [
        "password"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/aoiflux/fsagen/main/schemas/manifest-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Documents fsagen manifest input files. fsagen validates input itself; this schema mirrors those rules for editors.",
  "properties": {
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "minItems": 1,
      "type": "array"
    },
    "variables": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "operations"
  ],
  "title": "FSAGen Manifest Schema",
  "type": "object"
}
